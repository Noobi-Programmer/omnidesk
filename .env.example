# --- TinyFish (server-side only; get key at https://agent.tinyfish.ai/api-keys) ---
TINYFISH_API_KEY=

# --- Product LLM (server-side only) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Pipeline budget guards ---
OMNIDESK_MAX_SEARCHES=8
OMNIDESK_MAX_FETCH_URLS=20
OMNIDESK_MAX_AGENT_RUNS=2
OMNIDESK_AGENT_ENABLED=1

# --- Modes ---
DEMO_MODE=

# --- Client-safe ---
NEXT_PUBLIC_APP_NAME=OmniDesk
